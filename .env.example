# Application Ports
BACKEND_PORT=8000
FRONTEND_PORT=3000
MCP_PDF_PORT=8001
MCP_WEB_PORT=8002
MCP_DB_PORT=8003

# Gemini API
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash
EMBEDDING_MODEL=text-embedding-004
EMBEDDING_DIMENSION=768

# Application Database (PostgreSQL)
APP_DB_HOST=postgres-app
APP_DB_PORT=5432
APP_DB_USER=evidence_user
APP_DB_PASSWORD=evidence_password
APP_DB_NAME=evidence_graph

# Target Business Database (PostgreSQL for DB MCP)
TARGET_DB_HOST=postgres-target
TARGET_DB_PORT=5432
TARGET_DB_USER=target_user
TARGET_DB_PASSWORD=target_password
TARGET_DB_NAME=target_db

# Qdrant
QDRANT_HOST=qdrant
QDRANT_PORT=6333

# Logging
LOG_LEVEL=INFO
